# Template ".env" file.
# rename/copy to just ".env" in the projects root folder and fill in the variables

################################
# Third Party Credentials

# warcraftlogs
# (get them from here: https://www.warcraftlogs.com/api/clients)
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=


# Discord Settings used for Auth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
REDIRECT_URI="http://127.0.0.1:9001/login"


################################
# Game Version
# Which Game Version this deployment serves: "retail" (default), "forever" or "mists".
# LORRGS_GAME_VERSION=retail

# Where each Game Version's API lives. `/api/game_versions` hands these to the frontend, so it can
# switch between deployments. Unset = not offered in the frontend's Game Version menu.
# LORRGS_API_URL_RETAIL=https://api2.lorrgs.io
# LORRGS_API_URL_MISTS=
# LORRGS_API_URL_FOREVER=
