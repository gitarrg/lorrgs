#!/usr/bin/env bash
# Deploy the CDK app in infra/: the lorrgs stack (Lambdas, their layers, queues, API).
#
# Usage: scripts/deploy [<cdk command> [args...]]
#
#   scripts/deploy                 deploy (default: "deploy --all")
#   scripts/deploy deploy lorrgs   deploy the stack
#   scripts/deploy diff            show what would change (dry run)
#   scripts/deploy synth           build templates + assets into infra/cdk.out (offline)
#   scripts/deploy list            list the stacks
#
# Arguments are passed to the CDK CLI (npx aws-cdk@2); see docs/deploy_game_versions.md.

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

cd "$(dirname "$0")/.." || exit
export JSII_SILENCE_WARNING_UNTESTED_NODE_VERSION=1

if [[ $# -eq 0 ]]; then
    set -- deploy --all
fi
exec npx --yes aws-cdk@2 "$@"
